   "source": [
    "from scipy.optimize import brentq\n",
    "import numpy as np\n",
    "\n",
    "def f(R):\n",
    "    return np.exp(-100/R) - 0.5*np.exp(-500/R) - 0.5\n",
    "\n",
    "R_solution = brentq(f, 1, 10000)\n",
    "\n",
    "print(f\"{R_solution:.3g}\")\n",
    "\n"
   ]
  }
 ],
